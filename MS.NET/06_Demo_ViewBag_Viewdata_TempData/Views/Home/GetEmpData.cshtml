@model IEnumerable<_06_Demo_ViewBag_Viewdata_TempData.Models.Emp>
@{
    ViewData["Title"] = "GetEmpData Page";
}

@{
    for(int i=0;i<5;i++)
    {
        <p>@i</p>
    }
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Address</th>
        </tr>
    </thead>
    <tbody>
       
            @foreach(var emp in Model)
            {
    
            <tr>
            <td>@emp.EId</td>
                <td>@emp.EName</td>
                <td>@emp.Address</td>
            </tr>

            }
            </tbody>
</table>
       
