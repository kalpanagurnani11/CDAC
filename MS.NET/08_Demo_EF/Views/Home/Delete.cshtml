@model _08_Demo_EF.Models.Product

<h2>Delete Product</h2>

<h3>Are you sure you want to delete this product?</h3>

<table border="1">

    <tr>
        <td>Product Id</td>
        <td>@Model.ProductId</td>
    </tr>

    <tr>
        <td>Name</td>
        <td>@Model.ProductName</td>
    </tr>

    <tr>
        <td>Description</td>
        <td>@Model.ProductDescription</td>
    </tr>

    <tr>
        <td>Price</td>
        <td>@Model.ProductPrice</td>
    </tr>

    <tr>
        <td>Category</td>
        <td>@Model.ProductCategory?.CategoryName</td>
    </tr>

</table>

<form asp-action="Delete" method="post">

    <input asp-for="ProductId" type="hidden" />

    <button type="submit">
        Delete
    </button>

    <a asp-action="Index">Cancel</a>

</form>