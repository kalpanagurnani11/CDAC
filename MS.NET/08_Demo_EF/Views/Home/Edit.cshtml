@model _08_Demo_EF.Models.ProductViewModel

<form asp-action="Edit" method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    <input asp-for="Product.ProductId" type="hidden" />

    <label>Product Name</label>
    <input asp-for="Product.ProductName" />
    <br />

    <label>Description</label>
    <input asp-for="Product.ProductDescription" />
    <br />

    <label>Price</label>
    <input asp-for="Product.ProductPrice" />
    <br />

    <label>Category</label>

    <select asp-for="SelectedCategoryId">

        @foreach (var c in Model.Categories)
        {
            <option value="@c.CId">
                @c.CategoryName
            </option>
        }

    </select>

    <br />

    <button type="submit">
        Update
    </button>

</form>